{
  "$schema": "https://raw.githubusercontent.com/mmjclayton/ship-sop/main/docs/templates/ship-sop.schema.json",
  "trigger": {
    "mode": "auto",
    "throttle": {
      "min_diff_lines": 10,
      "skip_branch_patterns": [
        "^wip/",
        "^spike/",
        "^exp/"
      ]
    }
  },
  "agents": {
    "security-reviewer": {
      "enabled": true,
      "block_on": "CRITICAL",
      "paths": [
        "^scripts/",
        "\\.(sh|bash|zsh|py|rb)$",
        "(^|/)(server|api|routes?|auth|middleware|handlers?)/",
        "\\.(html|ejs|hbs|jsx|tsx|vue|svelte)$",
        "(^|/)\\.env",
        "(^|/)(Dockerfile|docker-compose[^/]*\\.ya?ml)$",
        "^\\.github/workflows/",
        "\\.sql$",
        "(^|/)migrations?/"
      ]
    },
    "compliance-reviewer": {
      "enabled": false,
      "block_on": "CRITICAL"
    },
    "code-reviewer": {
      "enabled": true,
      "block_on": "HIGH"
    },
    "silent-failure-hunter": {
      "enabled": true,
      "block_on": "HIGH"
    },
    "pr-test-analyzer": {
      "enabled": false,
      "block_on": "never"
    },
    "diagram-builder": {
      "enabled": false,
      "block_on": "never"
    }
  }
}
